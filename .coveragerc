[run]
branch = True
relative_files = True
source =
    strategies
    backtester
    signal_history
    pair_performance
    data_collector
    runtime
    quotexapi_provider
    a11ksa_provider
    a11ksa_candle_transport
    browser_ws_parser
    telegram_market_data
    health_monitor
    resilience
    observability
    strategy_manager
    strategy_registry
    walkforward
    validation_dashboard
    weekly_report
    production_checklist
omit =
    */tests/*
    */.venv/*
    */site-packages/*

[report]
show_missing = True
skip_covered = False

[html]
directory = htmlcov
